void setup() {
  Serial.begin(115200);

  // PCA9685 Başlat
  pca9685.begin();
  pca9685.setPWMFreq(50);

  // WiFi Hotspot Başlat
  WiFi.softAP(ssid, password);
  Serial.println("WiFi başlatıldı. IP: " + WiFi.softAPIP().toString());

  // Web Sunucusu Ayarları
  server.on("/", HTTP_GET, [](AsyncWebServerRequest *request){
    request->send_P(200, "text/html", htmlPage);
  });

  server.on("/move", HTTP_GET, [](AsyncWebServerRequest *request){
    String joint = request->getParam("joint")->value();
    String dir = request->getParam("dir")->value();
    handleMove(joint, dir);
    request->send(200, "text/plain", "ok");
  });

  server.on("/stop", HTTP_GET, [](AsyncWebServerRequest *request){
    String joint = request->getParam("joint")->value();
    handleStop(joint);
    request->send(200, "text/plain", "ok");
  });

  server.begin();
}

// Servo Hareket Fonksiyonu
void handleMove(String joint, String dir) {
  ServoSettings* servo = getServo(joint);
  if (!servo) return;

  if (dir == "forward" && servo->currentPos < servo->maxPos) {
    servo->currentPos += servo->stepSize;
  } else if (dir == "back" && servo->currentPos > servo->minPos) {
    servo->currentPos -= servo->stepSize;
  }
  pca9685.setPWM(servo->channel, 0, servo->currentPos);
}

// Servo Durdurma Fonksiyonu
void handleStop(String joint) {
  ServoSettings* servo = getServo(joint);
  if (!servo) return;

  // (Opsiyonel: Omuz için fren gibi özellik ekleyebilirsiniz.)
}

// Servo Yapısına Erişim
ServoSettings* getServo(String joint) {
  if (joint == "taban") return &servoTaban;
  if (joint == "omuz") return &servoOmuz;
  if (joint == "dirsek") return &servoDirsek;
  if (joint == "gripper") return &servoGripper;
  return nullptr;
}

void loop() {
  // Boş döngü, işlemler web üzerinden
}

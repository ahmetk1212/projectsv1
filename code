#include <WiFi.h>
#include <ESPAsyncWebServer.h>
#include <Adafruit_PWMServoDriver.h>

// WiFi Ayarları
const char* ssid = "YOUR_WIFI_SSID";       // WiFi adı
const char* password = "YOUR_WIFI_PASS";   // WiFi şifren

// Web Sunucusu ve Servo Sürücü
AsyncWebServer server(80);
Adafruit_PWMServoDriver pca9685 = Adafruit_PWMServoDriver();

// Servo Yapılandırması
struct ServoSettings {
  uint8_t channel;
  int minPos;
  int maxPos;
  int stopPos;
  int currentPos;
  int stepSize;
};

// Servolar
ServoSettings servoTaban = {0, 150, 600, 330, 330, 10};  // Taban servo (kanal 0)
ServoSettings servoOmuz = {1, 150, 600, 330, 330, 10};   // Omuz servo (kanal 1)
ServoSettings servoDirsek = {2, 150, 600, 330, 330, 10}; // Dirsek servo (kanal 2)
ServoSettings servoGripper = {3, 150, 600, 330, 330, 10}; // Gripper servo (kanal 3)

// Web Arayüz (HTML ve CSS)
const char* htmlPage PROGMEM = R"HTML(
<!DOCTYPE html>
